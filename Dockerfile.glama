# syntax=docker/dockerfile:1.7

FROM python:3.12.13-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.29@sha256:eb2843a1e56fd9e30c7276ce1a52cba86e64c7b385f5e3279a0e08e02dd058fc /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libffi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src/agentmem/sdk/python
ENV UV_PROJECT_ENVIRONMENT=/opt/lians/.venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=0

# Install the exact MCP dependency graph before copying frequently changing
# sources. The SDK lock is reviewed and committed with the image definition.
COPY agentmem/sdk/python/pyproject.toml agentmem/sdk/python/uv.lock build-constraints.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --extra mcp --no-install-project

# Preserve the repository layout expected by the SDK's audited build hook,
# which vendors the service engine into the distributable wheel.
COPY agentmem/src/ /src/agentmem/src/
COPY agentmem/sdk/python/ /src/agentmem/sdk/python/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv build --wheel \
      --build-constraint build-constraints.lock \
      --require-hashes \
      --out-dir /tmp/lians-sdk-wheel . \
    && uv pip install --python /opt/lians/.venv/bin/python --no-deps /tmp/lians-sdk-wheel/*.whl

# Local MCP mode is usable without downloading code or model artifacts at
# runtime. Remote model code is disabled and the revision is immutable.
ARG PREDOWNLOAD_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
ARG PREDOWNLOAD_MODEL_REVISION=ac6544c8a46e00af67e330e85a9028c66b8cfd9a
ENV SENTENCE_TRANSFORMERS_HOME=/opt/lians/model-cache
RUN mkdir -p /opt/lians/model-cache \
    && if [ -n "$PREDOWNLOAD_MODEL" ]; then \
      /opt/lians/.venv/bin/python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('$PREDOWNLOAD_MODEL', revision='$PREDOWNLOAD_MODEL_REVISION', trust_remote_code=False)"; \
    fi


FROM python:3.12.13-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 lians \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin lians \
    && install -d -o 10001 -g 10001 /data

COPY --from=builder --chown=10001:10001 /opt/lians/.venv /opt/lians/.venv
COPY --from=builder --chown=10001:10001 /opt/lians/model-cache /opt/lians/model-cache

ENV PATH=/opt/lians/.venv/bin:$PATH \
    LIANS_AGENT_ID=mcp-agent \
    LIANS_LOCAL_DB=/data/mcp.db \
    LIANS_NAMESPACE=mcp \
    SENTENCE_TRANSFORMERS_HOME=/opt/lians/model-cache \
    TRANSFORMERS_OFFLINE=1 \
    HF_DATASETS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER 10001:10001
VOLUME ["/data"]
ENTRYPOINT ["lians-mcp"]
