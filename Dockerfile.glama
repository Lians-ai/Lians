FROM python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36

# Hosted builders such as Glama may not support build arguments, so this
# fallback tracks the verified public image. The publisher always overrides
# and verifies this value before creating a versioned GHCR tag.
ARG LIANS_VERSION=0.5.0

RUN groupadd --system lians \
    && useradd --system --gid lians --create-home lians \
    && mkdir -p /data \
    && chown lians:lians /data \
    && test -n "${LIANS_VERSION}" \
    && pip install --no-cache-dir "lians-sdk[mcp]==${LIANS_VERSION}" \
    && LIANS_EXPECTED_VERSION="${LIANS_VERSION}" python -c "import importlib.metadata as m, os; expected=os.environ['LIANS_EXPECTED_VERSION']; actual=m.version('lians-sdk'); assert actual == expected, (actual, expected)"

LABEL org.opencontainers.image.version="${LIANS_VERSION}"

USER lians

ENV LIANS_AGENT_ID=mcp-agent \
    LIANS_LOCAL_DB=/data/mcp.db \
    LIANS_NAMESPACE=mcp \
    PYTHONUNBUFFERED=1

VOLUME ["/data"]

ENTRYPOINT ["lians-mcp"]
