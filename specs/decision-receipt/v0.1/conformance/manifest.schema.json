{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lians.ai/specs/decision-receipt/v0.1/conformance/manifest.schema.json",
  "title": "Decision Receipt v0.1 conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "suite",
    "manifest_version",
    "receipt_schema",
    "receipt_schema_sha256",
    "canonicalization",
    "trust_material",
    "cases"
  ],
  "properties": {
    "$schema": {
      "const": "https://lians.ai/specs/decision-receipt/v0.1/conformance/manifest.schema.json"
    },
    "suite": {"const": "lians-decision-receipt-v0.1"},
    "manifest_version": {"const": "1"},
    "receipt_schema": {"$ref": "#/$defs/path"},
    "receipt_schema_sha256": {"$ref": "#/$defs/sha256"},
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protected_top_level_members",
        "encoding",
        "member_name_order",
        "whitespace",
        "non_ascii",
        "non_finite_numbers",
        "signature_message",
        "probe"
      ],
      "properties": {
        "id": {"const": "json-sort-keys-utf8-v1"},
        "protected_top_level_members": {"const": "all members except integrity"},
        "encoding": {"const": "utf-8"},
        "member_name_order": {"const": "unicode-code-point-ascending-recursive"},
        "whitespace": {"const": "none outside JSON strings"},
        "non_ascii": {"const": "preserve decoded characters; do not ASCII-escape"},
        "non_finite_numbers": {"const": "reject"},
        "signature_message": {"const": "raw-32-byte-sha256-digest"},
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "expected_utf8_hex",
            "expected_utf8_length",
            "expected_sha256"
          ],
          "properties": {
            "input": {"type": "object"},
            "expected_utf8_hex": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{2})+$"
            },
            "expected_utf8_length": {"type": "integer", "minimum": 1},
            "expected_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "trust_material": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"$ref": "#/$defs/trustMaterial"}
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "nullableBoolean": {
      "type": ["boolean", "null"]
    },
    "trustMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "key_id", "encoding", "raw_key_sha256", "purpose"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "key_id": {"type": "string", "minLength": 1},
        "encoding": {"const": "raw-ed25519-public-key-base64"},
        "raw_key_sha256": {"$ref": "#/$defs/sha256"},
        "purpose": {"enum": ["trusted-fixture-key", "intentional-wrong-key"]}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "receipt_path",
        "receipt_file_sha256",
        "mutation_path",
        "mutation_file_sha256",
        "trusted_key",
        "require_signature",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {"type": "string", "minLength": 1},
        "receipt_path": {"$ref": "#/$defs/path"},
        "receipt_file_sha256": {"$ref": "#/$defs/sha256"},
        "mutation_path": {
          "oneOf": [
            {"$ref": "#/$defs/path"},
            {"type": "null"}
          ]
        },
        "mutation_file_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "trusted_key": {"type": ["string", "null"]},
        "require_signature": {"type": "boolean"},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valid",
            "schema_valid",
            "semantic_valid",
            "hash_valid",
            "signature_present",
            "signature_valid",
            "trusted_key",
            "declared_receipt_hash",
            "computed_protected_sha256",
            "canonical_protected_utf8_length"
          ],
          "properties": {
            "valid": {"type": "boolean"},
            "schema_valid": {"type": "boolean"},
            "semantic_valid": {"type": "boolean"},
            "hash_valid": {"type": "boolean"},
            "signature_present": {"type": "boolean"},
            "signature_valid": {"type": "boolean"},
            "trusted_key": {"$ref": "#/$defs/nullableBoolean"},
            "declared_receipt_hash": {"$ref": "#/$defs/sha256"},
            "computed_protected_sha256": {"$ref": "#/$defs/sha256"},
            "canonical_protected_utf8_length": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
