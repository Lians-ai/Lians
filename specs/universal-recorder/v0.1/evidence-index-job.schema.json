{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lians.ai/specs/universal-recorder/v0.1/evidence-index-job.schema.json",
  "title": "Lians Recorder Evidence Index Job v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "decision_id",
    "status",
    "snapshot_max_recorded_at",
    "snapshot_max_event_id",
    "snapshot_event_count",
    "cursor_recorded_at",
    "cursor_event_id",
    "events_indexed",
    "events_remaining",
    "artifacts_created",
    "links_created",
    "pages_completed",
    "processing_attempts",
    "progress_ratio",
    "complete",
    "next_attempt_at",
    "last_error_code",
    "last_error_digest",
    "failure_code",
    "created_at",
    "started_at",
    "updated_at",
    "completed_at",
    "failed_at"
  ],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "decision_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["pending", "running", "completed", "failed"]},
    "snapshot_max_recorded_at": {"type": "string", "format": "date-time"},
    "snapshot_max_event_id": {"type": "string", "format": "uuid"},
    "snapshot_event_count": {"type": "integer", "minimum": 501},
    "cursor_recorded_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "cursor_event_id": {"type": ["string", "null"], "format": "uuid"},
    "events_indexed": {"type": "integer", "minimum": 0},
    "events_remaining": {"type": "integer", "minimum": 0},
    "artifacts_created": {"type": "integer", "minimum": 0},
    "links_created": {"type": "integer", "minimum": 0},
    "pages_completed": {"type": "integer", "minimum": 0},
    "processing_attempts": {"type": "integer", "minimum": 0},
    "progress_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "complete": {"type": "boolean"},
    "next_attempt_at": {"type": "string", "format": "date-time"},
    "last_error_code": {"type": ["string", "null"], "maxLength": 64},
    "last_error_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "failure_code": {"type": ["string", "null"], "maxLength": 64},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "failed_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
