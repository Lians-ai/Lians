{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lians.ai/specs/universal-recorder/v0.2/event.schema.json",
  "title": "Lians Universal Recorder Event v0.2",
  "description": "Normalized, append-only Recorder evidence including operational observations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run_id", "protocol", "event_kind", "event_name", "phase", "status", "occurred_at", "recorded_at", "agent_id", "actor_attribution", "ingested_by_principal_ref", "ingested_by_auth_method", "ingested_by_credential_id", "trace_id", "span_id", "task_id", "decision_id", "model_id", "input_hash", "output_hash", "operational", "capture_mode", "capture_gaps", "diagnostics", "event_hash", "event_hash_version"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "protocol": {"enum": ["lians", "otlp.genai", "mcp", "a2a"]},
    "event_kind": {"type": "string"},
    "event_name": {"type": ["string", "null"]},
    "phase": {"type": "string"},
    "status": {"type": ["string", "null"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "agent_id": {"type": ["string", "null"]},
    "actor_attribution": {"enum": ["claimed_unverified", "not_supplied"]},
    "ingested_by_principal_ref": {"type": "string", "pattern": "^lians:principal:v1:"},
    "ingested_by_auth_method": {"type": "string"},
    "ingested_by_credential_id": {"type": ["string", "null"], "maxLength": 128},
    "trace_id": {"type": ["string", "null"]},
    "span_id": {"type": ["string", "null"]},
    "task_id": {"type": ["string", "null"]},
    "decision_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
    "model_id": {"type": ["string", "null"]},
    "input_hash": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "output_hash": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "operational": {"$ref": "envelope.schema.json#/$defs/operational"},
    "capture_mode": {"enum": ["metadata_only", "hash_only", "full"]},
    "capture_gaps": {"type": "array", "items": {"type": "string"}},
    "diagnostics": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_hash_version": {"enum": [1, 2]}
  }
}
