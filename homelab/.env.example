# Lians homelab defaults are local-only. `lab.ps1 up` / `lab.sh up` replace
# the sensitive values with random secrets in homelab/.env on first launch.
LIANS_ADMIN_SECRET=local-only-admin-secret-change-before-sharing
LIANS_MASTER_ENCRYPTION_KEY=bGlhbnMtaG9tZWxhYi1vbmx5LWtleS0wMDAwMDAwMDA=

# A fresh 32-byte Ed25519 private key is generated locally and never printed.
# The verifier requires the resulting Evidence Pack to be signed with this ID.
LIANS_EVIDENCE_SIGNING_PRIVATE_KEY=
LIANS_EVIDENCE_SIGNING_KEY_ID=lians-homelab-ed25519-v1

# Grafana is bound to 127.0.0.1. Change this before sharing the host.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=lians-local-only

# Seconds between synthetic, fully auditable decisions.
LAB_INTERVAL_SECONDS=20

# lab.ps1/lab.sh set LAB_SAMPLE_FILE for each invocation. Direct Compose usage
# falls back to samples/default.json. Never store the de-identified-data
# acknowledgement in this file.

# Container file ownership. lab.sh overrides this with the current host user ID.
LAB_UID=1000
