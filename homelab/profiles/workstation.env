# Safety ceilings for a 32-64 GB single-node workstation. Measure before using the ceiling.
LAB_SCALE_PROFILE=workstation
LAB_BULK_CONCURRENCY=16
LAB_DATASET_MAX_RECORDS=1000000
LAB_DATASET_MAX_BYTES=8589934592
LAB_DATASET_MAX_LINE_BYTES=16384
LAB_BULK_REQUEST_TIMEOUT_SECONDS=15
LAB_RATE_LIMIT_PER_MINUTE=250000
