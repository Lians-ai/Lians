# Lians platform environment configuration
# Copy this file to .env and fill in values before running docker compose up
#
# cp .env.example .env
#
# NEVER commit .env to source control.

DEPLOYMENT_ENVIRONMENT=development
# Authoritative server processing location used for namespace residency rules.
# Set this from deployment inventory; request headers never override it.
DEPLOYMENT_REGION=local

# ── Database ──────────────────────────────────────────────────────────────
# Inside Docker Compose the hostname is the service name ("postgres").
# For local development against a native Postgres, use "localhost".
DATABASE_URL=postgresql+asyncpg://agentmem:agentmem@postgres:5432/agentmem
# Production network connections require sslmode=verify-full. Mount a private
# CA and add sslrootcert=/absolute/path when system trust does not contain it.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
# Runtime statements and lock waits are bounded independently from the pool.
# Migration jobs use their own reviewed timeout budget.
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
MIGRATION_STATEMENT_TIMEOUT_MS=1500000
MIGRATION_LOCK_TIMEOUT_MS=5000
MIGRATION_IDLE_TRANSACTION_TIMEOUT_MS=300000

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# Production network connections require rediss://; Lians forces certificate
# and hostname verification. Colocated Unix sockets require an explicit,
# production-only exception and are never accepted implicitly.
PRODUCTION_ALLOW_LOCAL_DATA_SERVICE_SOCKETS=false

# ── Embeddings ────────────────────────────────────────────────────────────
# "sentence-transformers" — self-hosted, no external API calls (recommended
# for regulated / air-gapped deployments).
# Requires: pip install agentmem[local]
# Model is downloaded from HuggingFace on first use
# (~1.3 GB). For fully offline use, pre-download and
# set SENTENCE_TRANSFORMER_MODEL to the local path.
# "voyage"                — Voyage AI finance-tuned model (best accuracy,
# requires VOYAGE_API_KEY, data leaves network)
# "openai"                — OpenAI text-embedding-3-small (dev fallback,
# requires OPENAI_API_KEY, data leaves network)
# "local"                 — deterministic hash-projection for unit tests only
EMBEDDING_PROVIDER=sentence-transformers
SENTENCE_TRANSFORMER_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER_TIMEOUT_SECONDS=20
LLM_PROVIDER_TIMEOUT_SECONDS=20

# ── Encryption ────────────────────────────────────────────────────────────
# AES-256-GCM master key — 32 random bytes, base64-encoded.
# REQUIRED — AgentMem will refuse to start without this set.
# Generate:
# python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# For tests/demo only: set AGENTMEM_ALLOW_UNENCRYPTED=true to bypass (never with real data).
MASTER_ENCRYPTION_KEY=
SUBJECT_REFERENCE_KEY=
# Stable non-secret envelope identifier. Required in production and changed
# only when introducing a new current master key.
MASTER_KEY_ID=development-key
# During rotation only: set this and exactly one selected-provider previous
# material field, then remove both only after the offline operator reports safe.
MASTER_KEY_PREVIOUS_ID=
MASTER_ENCRYPTION_KEY_PREVIOUS=

# KMS provider for the master key:
# "env"   — read MASTER_ENCRYPTION_KEY from this file (development only;
#           production startup rejects this provider)
# "aws"   — AWS KMS envelope decryption (requires boto3)
# "azure" — Azure Key Vault Secrets (requires azure-keyvault-secrets)
# "vault" — HashiCorp Vault KV v2 (requires hvac)
KMS_PROVIDER=env

# AWS KMS (KMS_PROVIDER=aws)
# KMS_AWS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/...
# KMS_AWS_REGION=us-east-1
# KMS_AWS_ENCRYPTED_KEY=<base64 CiphertextBlob from aws kms generate-data-key>
# KMS_AWS_PREVIOUS_KEY_ID=<prior CMK ARN, optional when blob is self-identifying>
# KMS_AWS_PREVIOUS_REGION=us-east-1
# KMS_AWS_PREVIOUS_ENCRYPTED_KEY=<prior base64 CiphertextBlob>

# Azure Key Vault (KMS_PROVIDER=azure)
# KMS_AZURE_VAULT_URL=https://myvault.vault.azure.net/
# KMS_AZURE_SECRET_NAME=agentmem-master-key
# KMS_AZURE_PREVIOUS_VAULT_URL=https://myvault.vault.azure.net/
# KMS_AZURE_PREVIOUS_SECRET_NAME=agentmem-master-key-previous

# HashiCorp Vault (KMS_PROVIDER=vault)
# KMS_VAULT_ADDR=http://127.0.0.1:8200
# KMS_VAULT_TOKEN=
# KMS_VAULT_PATH=agentmem/master-key
# KMS_VAULT_PREVIOUS_ADDR=http://127.0.0.1:8200
# KMS_VAULT_PREVIOUS_PATH=agentmem/master-key-previous
# KMS_VAULT_PREVIOUS_MOUNT_POINT=secret

# ── Decision Receipt trust ────────────────────────────────────────────────
# Decision Receipt v0.1 signing (optional in development, required in production).
# "local" keeps a raw key in this process; "vault-transit" delegates signing
# to a pinned HashiCorp Vault Transit Ed25519 key.
RECEIPT_SIGNING_PROVIDER=local
# Local provider only: 32 raw Ed25519 private-key bytes encoded as base64 or
# 64 hexadecimal characters.
# Generate a base64 key:
# python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
RECEIPT_SIGNING_PRIVATE_KEY=
# Production must use an environment-specific ID published with the public key.
RECEIPT_SIGNING_KEY_ID=lians-local-receipt-v1

# Vault Transit provider only. Production requires HTTPS. The version must be
# positive and explicit; latest/0 is rejected. Pin the matching raw 32-byte
# public key as base64 or hex. Lians checks Vault metadata at load and locally
# verifies every returned signature before emitting a receipt.
RECEIPT_VAULT_ADDR=
# Direct token compatibility mode. Prefer TOKEN_FILE with a Vault Agent token
# sink (including Kubernetes-auth deployments); configure exactly one field.
RECEIPT_VAULT_TOKEN=
RECEIPT_VAULT_TOKEN_FILE=
# Optional Vault Enterprise namespace, for example admin/payments.
RECEIPT_VAULT_NAMESPACE=
RECEIPT_VAULT_MOUNT_POINT=transit
RECEIPT_VAULT_KEY_NAME=
RECEIPT_VAULT_KEY_VERSION=0
RECEIPT_VAULT_PUBLIC_KEY=
# Hard bounded by the application to 0.25-10 seconds.
RECEIPT_VAULT_TIMEOUT_SECONDS=5

# ── Admin ────────────────────────────────────────────────────────────────
# Separate break-glass secret (not an API key) protects /v1/admin/* endpoints.
# It can provision across tenants, manage information barriers, and configure
# retention policies. Normal tenant issuance uses the human-OIDC-only workload
# credential lifecycle. Keep this off public networks and change it in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET=dev-admin-secret-change-in-production
# "public" excludes every /v1/admin/* break-glass router. Run a separate,
# private process with "admin" for bootstrap/disaster recovery. "all" combines
# both surfaces for local tests only and is rejected in production.
API_SURFACE=public

# ── LLM adjudication — Stage 3 supersession (optional) ───────────────────
# Catches paraphrase supersessions that rule-based Stage 2 misses.
# Costs ~$0.00025 per call (Claude Haiku); disabled by default.
ANTHROPIC_API_KEY=
LLM_ADJUDICATION_MODEL=claude-haiku-4-5-20251001
SUPERSESSION_LLM_STAGE=false
# Development-only process queue. Production rejects true until this queue is
# durable; use false to await the bounded adjudication before committing.
LLM_ADJUDICATION_ASYNC=true

# ── Domain adapter ────────────────────────────────────────────────────────
# "finance"     — ticker/ISIN/CUSIP normalization; structured keys: ticker,
# metric, entity, isin, cusip, instrument, field.
# Default for quant firms and commercial banks.
# "healthcare"  — ICD-10, NPI, medication name normalization; structured keys:
# patient_id, condition, medication, encounter_id, provider_id,
# procedure_code.  Requires HIPAA BAA before processing real PHI.
# Pair with: AIRGAP_MODE=true, RLS_BARRIERS_ENABLED=true
# "legal"       — matter ID, jurisdiction, claim type normalization; structured
# keys: matter_id, jurisdiction, claim_type, party_id,
# privilege_date, document_type.  Enforces Chinese walls via
# barrier_group=<matter_team_id> on each agent.
# "passthrough" — no normalization; pure semantic supersession only.
# Starting point for custom verticals.
DOMAIN_ADAPTER=finance

# ── Recall hot cache ─────────────────────────────────────────────────────
# Redis and PostgreSQL are both required for coherent caching. Recall takes a
# shared per-agent PostgreSQL advisory lock and validates a Redis generation;
# writes take the exclusive lock and must advance that generation before commit.
# Redis read/write failures bypass caching. An invalidation failure aborts the
# memory mutation rather than risk serving a superseded fact after commit.
# Non-PostgreSQL deployments always bypass recall and session caches.
RECALL_CACHE_ENABLED=true
RECALL_CACHE_TTL_SECONDS=60

# ── Supersession review ───────────────────────────────────────────────────
# Supersessions with confidence below this threshold appear in
# GET /v1/supersessions/review for human review.
SUPERSESSION_REVIEW_THRESHOLD=0.75
# A write fails closed with `supersession_candidate_capacity_exceeded` rather
# than silently deciding from a truncated candidate set. Tune together: the
# byte limit includes encrypted content, metadata, and row/embedding overhead.
SUPERSESSION_CANDIDATE_LIMIT=500
SUPERSESSION_CANDIDATE_BYTES_LIMIT=33554432
# Exclusive graph writes are complete-or-error because every invalidated edge
# receives its own immutable audit/integration event in the same transaction.
GRAPH_EXCLUSIVE_INVALIDATION_LIMIT=500
# Extraction validates the complete raw candidate set before graph mutation.
# Configure the row and serialized-byte ceilings together.
GRAPH_EXTRACT_CANDIDATE_LIMIT=250
GRAPH_EXTRACT_CANDIDATE_BYTES_LIMIT=2097152
# Complete decision evidence normalization is atomic. Candidate count includes
# duplicates supplied by the request; bytes include the normalized artifact,
# edge, basis, and risk payload before any upsert or completeness claim.
DECISION_EVIDENCE_CANDIDATE_LIMIT=5000
DECISION_EVIDENCE_CANDIDATE_BYTES_LIMIT=16777216

# ── Audit chain ───────────────────────────────────────────────────────────
# Experimental process-local Merkle windows. Production startup rejects this
# until membership and anchor publication are transactionally durable.
MERKLE_BATCH_ENABLED=false
MERKLE_BATCH_SIZE=64

# ── Information barriers (RLS) ────────────────────────────────────────────
# Enforces information barriers at the PostgreSQL row-level security layer.
# Applied automatically by migration 0011_rls_barriers (alembic upgrade head).
# Enabled by default. Set false only on non-Postgres backends or before
# running the migration on an existing cluster.
RLS_BARRIERS_ENABLED=true

# ── Retention scheduler ───────────────────────────────────────────────────
# Interval (hours) between automated content-prune cycles.
# Set to 0 to disable; requires a retention policy to be set per namespace.
RETENTION_PRUNE_INTERVAL_HOURS=24
# Durable keyset enumeration keeps only this many tenant keys in memory.
RETENTION_NAMESPACE_PAGE_SIZE=64
# Each leader cycle stops here, persists its cursor, then continues after a short yield.
RETENTION_MAX_NAMESPACES_PER_CYCLE=512
# Refresh tenant-free durable Prometheus inventories from the database.
OBSERVABILITY_REFRESH_SECONDS=30

# Autonomous exhaustive impact-assessment processing. Jobs preserve a frozen
# decision/link watermark and commit each bounded page with its cursor.
IMPACT_ASSESSMENT_WORKER_ENABLED=true
IMPACT_ASSESSMENT_WORKER_POLL_SECONDS=1
IMPACT_ASSESSMENT_WORKER_BATCH_SIZE=4
IMPACT_ASSESSMENT_WORKER_CONCURRENCY=2
IMPACT_ASSESSMENT_WORKER_LEASE_SECONDS=120
IMPACT_ASSESSMENT_WORKER_PAGE_SIZE=250
IMPACT_ASSESSMENT_WORKER_MAX_PAGES_PER_CLAIM=1
IMPACT_ASSESSMENT_WORKER_RETRY_BASE_SECONDS=2
IMPACT_ASSESSMENT_WORKER_RETRY_MAX_SECONDS=300
IMPACT_ASSESSMENT_WORKER_MAX_ATTEMPTS=8

# Fixed-snapshot back-linking for decisions with >500 prior Recorder events.
RECORDER_EVIDENCE_INDEX_WORKER_ENABLED=true
RECORDER_EVIDENCE_INDEX_WORKER_POLL_SECONDS=1
RECORDER_EVIDENCE_INDEX_WORKER_BATCH_SIZE=4
RECORDER_EVIDENCE_INDEX_WORKER_CONCURRENCY=2
RECORDER_EVIDENCE_INDEX_WORKER_LEASE_SECONDS=120
RECORDER_EVIDENCE_INDEX_WORKER_PAGE_SIZE=100
RECORDER_EVIDENCE_INDEX_WORKER_MAX_PAGES_PER_CLAIM=2
RECORDER_EVIDENCE_INDEX_WORKER_RETRY_BASE_SECONDS=2
RECORDER_EVIDENCE_INDEX_WORKER_RETRY_MAX_SECONDS=300
RECORDER_EVIDENCE_INDEX_WORKER_MAX_ATTEMPTS=8

# Durable fixed-snapshot data-subject erasure (required in production)
SUBJECT_ERASURE_WORKER_ENABLED=true
SUBJECT_ERASURE_WORKER_POLL_SECONDS=1
SUBJECT_ERASURE_WORKER_BATCH_SIZE=4
SUBJECT_ERASURE_WORKER_CONCURRENCY=2
SUBJECT_ERASURE_WORKER_LEASE_SECONDS=120
SUBJECT_ERASURE_WORKER_PAGE_SIZE=250
SUBJECT_ERASURE_WORKER_MAX_PAGES_PER_CLAIM=2
SUBJECT_ERASURE_WORKER_RETRY_BASE_SECONDS=2
SUBJECT_ERASURE_WORKER_RETRY_MAX_SECONDS=300
SUBJECT_ERASURE_WORKER_MAX_ATTEMPTS=8

# ── Billing (Stripe) ──────────────────────────────────────────────────────
# Billable usage is committed to Postgres in the same transaction as its source
# event, then leased safely across replicas. An empty API key pauses provider
# delivery without discarding already-staged facts.
# Configure per-namespace customer IDs via PUT /v1/admin/billing/{namespace}.
STRIPE_API_KEY=
# Product-native protected units. Keep these names mapped to distinct Stripe
# meters so decision evidence and successfully mediated actions remain legible.
STRIPE_METER_DECISION_EVENT=lians_authoritative_decision
STRIPE_METER_PROTECTED_ACTION_EVENT=lians_protected_action
# Compatibility units for existing memory-product contracts.
STRIPE_METER_WRITE_EVENT=agentmem_memory_write
STRIPE_METER_RECALL_EVENT=agentmem_memory_recall
# Production must subscribe a durable Stripe thin-event destination to the
# asynchronous meter error events documented in docs/durable-metering.md.
STRIPE_METER_ASYNC_ERROR_DESTINATION_CONFIGURED=false
STRIPE_METER_WORKER_ENABLED=true
STRIPE_METER_WORKER_POLL_SECONDS=1
STRIPE_METER_WORKER_BATCH_SIZE=64
STRIPE_METER_DELIVERY_CONCURRENCY=8
STRIPE_METER_LEASE_SECONDS=60
STRIPE_METER_PROVIDER_TIMEOUT_SECONDS=10
STRIPE_METER_RETRY_BASE_SECONDS=2
STRIPE_METER_RETRY_MAX_SECONDS=900
STRIPE_METER_MAX_ATTEMPTS=12
# Stop automatic replay before Stripe's guaranteed 24-hour identifier-dedupe
# boundary; reconcile and explicitly replay dead letters after longer outages.
STRIPE_METER_IDEMPOTENCY_WINDOW_SECONDS=82800
# 34-day buffer inside Stripe's 35-calendar-day meter-event acceptance bound.
STRIPE_METER_MAX_EVENT_AGE_SECONDS=2937600

# ── Session cache (in-process working set) ────────────────────────────────
# The process-local working set is enabled only when the shared Redis generation
# can be validated. These bounds also apply to derived scoring packs.
SESSION_CACHE_TTL_SECONDS=300
SESSION_CACHE_MAX_ENTRIES=512

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use "*" only for open-access demo instances.
# In production: "https://app.example.com,https://admin.example.com"
CORS_ORIGINS=*

# ── Observability ─────────────────────────────────────────────────────────
METRICS_ENABLED=false
# LOG_JSON=true  → one JSON object per line (Datadog / Splunk / CloudWatch)
# LOG_JSON=false → human-readable format for local development
LOG_LEVEL=INFO
LOG_JSON=true

# ── Rate limiting ─────────────────────────────────────────────────────────
# Per API key, sliding 60-second window backed by Redis.
RATE_LIMIT_PER_MINUTE=300
# A separate per-client-network ceiling prevents credential-rotation bypasses.
RATE_LIMIT_NETWORK_MULTIPLIER=20
RATE_LIMIT_ADMIN_PER_MINUTE=60
# local = bounded per-process fallback; deny = 503; open = development only.
RATE_LIMIT_BACKEND_FAILURE_MODE=local
# Comma-separated CIDRs of proxies that connect directly to this process.
# X-Forwarded-For is ignored unless the socket peer is in one of these ranges.
# Keep empty for direct development. Never use *, 0.0.0.0/0, or ::/0.
TRUSTED_PROXY_CIDRS=
MAX_REQUEST_BODY_BYTES=2000000
# Fail closed before decrypting/materializing oversized exports. Hash-only
# receipts intentionally use a smaller independent budget.
CONTENT_EXPORT_PAGE_BYTES_LIMIT=33554432
HASH_ONLY_EXPORT_PAGE_BYTES_LIMIT=16777216
AUDIT_EXPORT_PAGE_BYTES_LIMIT=16777216
LINEAGE_RESPONSE_BYTES_LIMIT=16777216

# Tenant OIDC administrators may mint only expiring workload credentials.
# Production startup fails closed if these bounds are invalid. Last-used writes
# are approximate and conditionally persisted at most once per interval.
WORKLOAD_CREDENTIAL_MIN_TTL_SECONDS=300
WORKLOAD_CREDENTIAL_MAX_TTL_SECONDS=2592000
WORKLOAD_CREDENTIAL_LAST_USED_WRITE_INTERVAL_SECONDS=900

# Full Recorder payload capture can contain sensitive prompts/tool results.
# Leave false unless storage encryption, retention, and access policy are explicit.
RECORDER_ALLOW_FULL_CAPTURE=false
OTLP_CAPTURE_MODE=hash_only
# Reject the entire export before persistence when either cardinality ceiling is
# crossed. Configure collectors to split and retry rejected batches.
OTLP_MAX_SPANS_PER_REQUEST=2000
OTLP_MAX_GENAI_TRACES_PER_REQUEST=500
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=

# â”€â”€ Durable enterprise integration outbox â”€â”€
# Transactional at-least-once delivery for SIEM/GRC/ticketing/billing sinks.
INTEGRATION_WORKER_ENABLED=true
INTEGRATION_WORKER_POLL_SECONDS=1
INTEGRATION_WORKER_BATCH_SIZE=64
INTEGRATION_DELIVERY_CONCURRENCY=8
# Must exceed the largest destination timeout (up to 120 seconds).
INTEGRATION_LEASE_SECONDS=180
INTEGRATION_RETRY_BASE_SECONDS=2
INTEGRATION_RETRY_MAX_SECONDS=900
INTEGRATION_MAX_PAYLOAD_BYTES=262144
INTEGRATION_MAX_RESPONSE_DIGEST_BYTES=65536
# Hard active-destination/fan-out ceiling; enqueue refuses legacy excess.
INTEGRATION_MAX_DESTINATIONS_PER_EVENT=100
# Private RFC1918/ULA sinks require an explicit deployment and egress-policy review.
INTEGRATION_ALLOW_PRIVATE_NETWORK=false
# Rejected at production startup; intended only for isolated local development.
INTEGRATION_ALLOW_INSECURE_HTTP=false
# Hash/reference-only audit exports are the privacy-safe default.
INTEGRATION_INCLUDE_AUDIT_PAYLOAD=false

# Retired, lossy compatibility egress. Both are rejected in production; use
# namespace-scoped durable /v1/integrations destinations instead.
LEGACY_WEBHOOKS_ENABLED=false
# Compatibility-only namespace ceiling; registration is serialized and excess
# pre-existing rows make list/fan-out fail closed instead of truncating.
LEGACY_WEBHOOK_MAX_ENDPOINTS_PER_NAMESPACE=50
# SIEM_URL=
# SIEM_TOKEN=

# ── Air-gapped mode ──────────────────────────────────────────────────────
# Set AIRGAP_MODE=true to disable application-managed, payload-bearing egress.
# Startup hard-fails if an external embedding/LLM, legacy SIEM, Stripe, or
# application OTLP exporter is configured. Legacy webhooks, durable integration
# delivery, metering, and telemetry are also disabled at the call/worker layer.
# This is defense in depth, not a network firewall: independently deny egress
# except the exact database, Redis, DNS, IdP/JWKS, and KMS paths your deployment
# requires.
#
# Recommended stack for air-gapped deployments:
# AIRGAP_MODE=true
# EMBEDDING_PROVIDER=sentence-transformers
# SENTENCE_TRANSFORMER_MODEL=/opt/models/bge-large-en-v1.5  (pre-downloaded)
# SUPERSESSION_LLM_STAGE=false
# GRAPH_EXTRACT_LLM=false
# AUTO_METADATA_LLM=false
# SIEM_URL=
# STRIPE_API_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=
AIRGAP_MODE=false

# ── OpenTelemetry (optional) ──────────────────────────────────────────────
# Set OTEL_EXPORTER_OTLP_ENDPOINT to send traces to your observability
# platform (Grafana Tempo, Datadog, Honeycomb, etc.).
OTEL_SERVICE_NAME=lians
OTEL_EXPORTER_OTLP_ENDPOINT=
