FROM postgres:16.14-bookworm@sha256:92620daddcd947f8d5ab5ba66e848702fe443d87fed30c4cea8e389fd78dfc55

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 liansbackup \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin liansbackup

WORKDIR /opt/lians-backup
COPY --chown=root:root requirements-worm.lock ./requirements-worm.lock
RUN python3 -m venv /opt/lians-worm-venv \
    && /opt/lians-worm-venv/bin/python -m pip install \
        --disable-pip-version-check \
        --no-cache-dir \
        --no-compile \
        --require-hashes \
        --requirement requirements-worm.lock

COPY --chown=root:root . ./
RUN chmod -R a=rX,u+w /opt/lians-backup

USER 10001:10001
ENTRYPOINT []
CMD ["/opt/lians-worm-venv/bin/python", "/opt/lians-backup/upload_worm_handoff.py", "--help"]
