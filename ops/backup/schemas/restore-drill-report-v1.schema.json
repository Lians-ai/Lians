{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lians:ops:restore-drill-report:v1",
  "title": "Lians restore drill report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "started_at",
    "completed_at",
    "backup_id",
    "source_manifest_sha256",
    "target",
    "safety_checks",
    "restore_error",
    "verification_errors",
    "schema_verification",
    "audit_topology_verification",
    "limitations"
  ],
  "properties": {
    "schema": { "const": "urn:lians:ops:restore-drill-report:v1" },
    "status": { "enum": ["passed", "failed"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "backup_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,79}$" },
    "source_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target": { "type": "object" },
    "safety_checks": { "type": "object" },
    "restore_error": { "type": ["string", "null"] },
    "verification_errors": { "type": "array", "items": { "type": "string" } },
    "schema_verification": { "type": "object" },
    "audit_topology_verification": { "type": "object" },
    "limitations": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
