# Copy this file OUTSIDE the repository, restrict it to mode 0600, replace all
# required placeholders, and load it through kubectl or an approved secrets
# manager. Never commit the populated copy.
DATABASE_URL=postgresql+asyncpg://CHANGE_ME
REDIS_URL=redis://CHANGE_ME
MASTER_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
ADMIN_SECRET=CHANGE_ME_random_32_or_more_characters
API_SECRET_SEED=CHANGE_ME_random_32_or_more_characters
PROVISIONING_SECRET=
EVIDENCE_SIGNING_PRIVATE_KEY=
EVIDENCE_SIGNING_KEY_ID=lians-enterprise
VOYAGE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STRIPE_API_KEY=
KMS_AWS_REGION=us-east-1
KMS_AWS_ENCRYPTED_KEY=
KMS_AWS_KEY_ID=
KMS_AZURE_VAULT_URL=
KMS_AZURE_SECRET_NAME=lians-master-key
KMS_VAULT_ADDR=
KMS_VAULT_TOKEN=
KMS_VAULT_PATH=lians/master-key
KMS_VAULT_MOUNT_POINT=secret
