{
  "name": "lians-lians-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-and-inspect.cjs",
    "dev": "webpack --config webpack.config.cjs --mode development --watch",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build",
    "audit:ci": "npm audit --omit=peer --audit-level=moderate"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@swc/core": "^1.15.0",
    "copy-webpack-plugin": "^14.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "swc-loader": "^0.2.6",
    "typescript": "^5.9.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.0"
  },
  "peerDependencies": {
    "@grafana/data": ">=12.4.6 <14",
    "@grafana/ui": ">=12.4.6 <14",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@grafana/data": {
      "optional": true
    },
    "@grafana/ui": {
      "optional": true
    }
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "lodash": "4.18.1",
    "react-use": "17.6.1"
  },
  "engines": {
    "node": ">=22"
  }
}
