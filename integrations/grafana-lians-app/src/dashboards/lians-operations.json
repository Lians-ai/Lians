{
  "title": "Lians Operations",
  "uid": "lians-operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["lians", "opentelemetry", "compliance"],
  "panels": [
    {
      "type": "stat",
      "title": "Lians governed operation rate",
      "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prometheus}"},
          "expr": "(sum(rate(agentmem_memory_writes_total[5m])) or vector(0)) + (sum(rate(agentmem_memory_recalls_total[5m])) or vector(0))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Lians recall latency p95",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prometheus}"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agentmem_recall_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      }
    ]
  }
}
