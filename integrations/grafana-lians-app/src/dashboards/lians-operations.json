{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Datasource scraping the Lians /metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Lians Evidence Capture",
  "uid": "lians-operations",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "tags": ["lians", "opentelemetry", "genai", "evidence"],
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "OTLP spans accepted",
      "description": "Unsampled spans accepted by the Lians evidence receiver.",
      "id": 1,
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum(increase(lians_otel_spans_accepted_total[$__range]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Decisions correlated",
      "description": "Decision records created automatically from GenAI traces.",
      "id": 2,
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum(increase(lians_otel_decisions_correlated_total[$__range]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Open memory conflicts",
      "id": 3,
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum(agentmem_conflict_queue_depth)", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Evidence stream status",
      "id": 4,
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum(rate(lians_otel_spans_accepted_total[5m]))", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "range", "options": {"from": 0.000001, "to": 1000000, "result": {"text": "Receiving", "color": "green"}}},
            {"type": "special", "options": {"match": "null", "result": {"text": "No data", "color": "red"}}}
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Evidence ingestion rate",
      "id": 5,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum by (namespace) (rate(lians_otel_spans_accepted_total[5m]))", "legendFormat": "{{namespace}} spans/s", "refId": "A"},
        {"expr": "sum by (namespace) (rate(lians_otel_decisions_correlated_total[5m]))", "legendFormat": "{{namespace}} decisions/s", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory quality activity",
      "id": 6,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum by (namespace) (rate(agentmem_conflicts_detected_total[5m]))", "legendFormat": "{{namespace}} detected", "refId": "A"},
        {"expr": "sum by (namespace) (rate(agentmem_conflicts_resolved_total[5m]))", "legendFormat": "{{namespace}} resolved", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Recall latency p95",
      "id": 7,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, namespace) (rate(agentmem_recall_duration_seconds_bucket[5m])))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Degraded recall rate",
      "id": 8,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 15},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum by (namespace) (rate(agentmem_memory_recalls_total{router=\"semantic_degraded\"}[5m]))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    }
  ]
}
