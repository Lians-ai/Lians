{
  "mcpServers": {
    "lians": {
      "command": "uvx",
      "args": [
        "--from",
        "lians-sdk[mcp]",
        "lians-mcp"
      ],
      "timeout": 120000,
      "trust": false,
      "includeTools": [
        "remember",
        "recall",
        "list_memories",
        "correct_memory",
        "forget_memory"
      ]
    }
  }
}
